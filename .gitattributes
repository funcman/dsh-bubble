# Force LF for source files we author; leave binary alone.
* text=auto eol=lf

# Explicit overrides — belt-and-suspenders for the formats editors mishandle
# the most often.
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.js     text eol=lf
*.cjs    text eol=lf
*.mjs    text eol=lf
*.ts     text eol=lf
*.d.ts   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.sh     text eol=lf